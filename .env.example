# ======================================================
# BGMI Market — Environment Template (Cloudflare Workers)
# ======================================================
# This project runs entirely on:
#   - Cloudflare Workers + D1 (backend /api services)
#   - Vercel (frontend static site, repo: bgmi-frontend)
#
# Worker runtime vars are configured per service in:
#   services/<service>/hosting_cloudflare/wrangler.toml   ([vars])
#   services/wallet_service/wrangler.toml
# Secrets (never commit) are set with:
#   wrangler secret put <NAME> --name <worker>

# ---------- Shared JWT (MUST be identical across all workers) ----------
# Generate:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---------- Admin credentials (auth worker + gateway worker) ----------
ADMIN_EMAIL=admin@bgmimarket.dev
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=Admin
ADMIN_PHONE=0000000000

# ---------- Wallet worker (direct UPI, no gateway) ----------
# Payment happens directly to a UPI ID (seller's own, or platform fallback
# when the seller has none). Buyer pays via any UPI app, submits the UTR,
# and the admin verifies it manually then releases escrow.
# Set on the `bgmi-marketplace` worker via `wrangler secret put`.
ADMIN_UPI_ID=pay@yourplatform
ADMIN_UPI_NAME=Your Platform Name

# ---------- Auth worker (Brevo OTP email) ----------
BREVO_API_KEY=

# ---------- Gateway worker (service URLs) ----------
# NOTE: These are the ACTUAL deployed worker names. Do not rename
# workers without updating these URLs AND the frontend constants.
AUTH_SERVICE_URL=https://auth-service.bgmi-gateway.workers.dev
MARKET_SERVICE_URL=https://bgmi_marketplace_service.bgmi-gateway.workers.dev
WALLET_SERVICE_URL=https://bgmi-marketplace.bgmi-gateway.workers.dev
VERIFY_SERVICE_URL=https://verification_service.bgmi-gateway.workers.dev
CHAT_SERVICE_URL=https://bgmi_chat_service.bgmi-gateway.workers.dev
